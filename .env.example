# OPENAI_API_KEY: Vision-LLM (2D teknik resim analizi) ve otomatik geri bildirim
# icin gereklidir. https://platform.openai.com/api-keys adresinden alinir.
# Bu dosyayi .env olarak kopyalayip anahtarinizi girin:
#   cp .env.example .env
OPENAI_API_KEY=sk-...

# --------------------------------------------------------------- Firebase Auth
# Backend, gelen Firebase ID token'larini Admin SDK ile dogrular.
#
# Anahtari almak icin:
#   Firebase Console > Project settings > Service accounts
#   > "Generate new private key" > inen JSON'u proje kokune
#     serviceAccountKey.json adiyla kaydedin.
#
# Dosya proje kokunde serviceAccountKey.json ise asagidakilere gerek yoktur.
# Farkli bir yol kullanacaksaniz:
# FIREBASE_SERVICE_ACCOUNT=C:/yol/serviceAccountKey.json
#
# Ya da JSON'u dogrudan (tek satir, deploy ortamlari icin pratik):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Admin yetkisi verilecek e-postalar (virgulle ayrilir).
# Bos birakilirsa varsayilan: aslantaner194@gmail.com
# MECHCODE_ADMIN_EMAILS=aslantaner194@gmail.com

# Yerel gelistirmede token dogrulamasini tamamen kapatmak icin false yapin.
# Uretimde ASLA false birakmayin.
# MECHCODE_AUTH_REQUIRED=true
